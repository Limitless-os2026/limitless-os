{
  // Cloudflare deploy settings. The app is plain static files in dist/.
  // Every unknown path falls back to index.html so links into the app work.
  "name": "limitless-os",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
